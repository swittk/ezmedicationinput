{
  "name": "ezmedicationinput",
  "version": "0.1.67",
  "description": "Parse concise medication sigs into FHIR R5 Dosage JSON",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test:dist": "npm run build && vitest run test-dist",
    "build": "tsup && tsc -p tsconfig.types.json",
    "test": "vitest run --dir test",
    "bench:torture": "npm run build && node bench/real-world-torture.mjs",
    "bench:adversarial": "npm run build && node bench/adversarial.mjs",
    "bench:roundtrip": "npm run build && node bench/roundtrip.mjs",
    "bench:suggest": "npm run build && node --expose-gc bench/suggest.mjs",
    "experiment:boundaries": "node experiments/boundary-planner/run.mjs --audit --bench --strict",
    "test:boundaries": "vitest run --config experiments/boundary-planner/vitest.experiment.config.ts",
    "test:shadow-boundaries": "vitest run --config experiments/boundary-planner/vitest.shadow.config.ts",
    "typecheck:boundaries": "tsc -p experiments/boundary-planner/tsconfig.json",
    "explain:boundaries": "node experiments/boundary-planner/explain.mjs",
    "test:boundary-clinical": "vitest run --config experiments/boundary-planner/vitest.acceptance.config.ts",
    "typecheck:boundary-integration": "node experiments/boundary-planner/typecheck-integration.mjs"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "fhir",
    "hl7",
    "dosage",
    "parser"
  ],
  "author": "swittk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/swittk/ezmedicationinput"
  },
  "bugs": "https://github.com/swittk/ezmedicationinput/issues",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  }
}
